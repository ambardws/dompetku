# ─────────────────────────────────────────────────────────────
# Dompetku - Environment Variables
# ─────────────────────────────────────────────────────────────
# Salin file ini ke .env dan isi nilainya
# JANGAN commit .env ke git repository!
# ─────────────────────────────────────────────────────────────

# ── Supabase Configuration ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── Dompetku App Bot (untuk user app) ────────────────────────
TELEGRAM_BOT_TOKEN=your-dompetku-app-bot-token

# ── Dev Incident Bot (untuk CI/CD notifikasi developer) ──────
# Bot TERPISAH dari bot Dompetku app — khusus untuk dev alerts
# Cara setup:
#   1. Buka @BotFather di Telegram → /newbot
#   2. Beri nama: "Dompetku Dev Bot" (atau bebas)
#   3. Copy token yang diberikan ke TELEGRAM_DEV_BOT_TOKEN
#   4. Cek chat ID kamu via @userinfobot → isi ke TELEGRAM_DEV_CHAT_ID
#   5. Tambahkan juga ke GitHub Secrets:
#      Settings → Secrets and variables → Actions → New repository secret
TELEGRAM_DEV_BOT_TOKEN=your-dev-bot-token-from-botfather
TELEGRAM_DEV_CHAT_ID=your-telegram-chat-id

# ── Optional: Local Supabase CLI ─────────────────────────────
# SUPABASE_URL=http://localhost:54321
# SUPABASE_KEY=your-local-anon-key
